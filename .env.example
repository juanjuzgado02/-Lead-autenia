# ============================================================================
# Autenia Viral Shorts
# ============================================================================
# Every key is read here, server-side. There is no browser and no dashboard, so
# there is nowhere else a key could live. Copy this file to .env and fill in
# what the phase you are running needs — the bot boots without the rest and says
# what is missing when it reaches something that needs it.

# --- Provider keys ---
# Research, judgement, script and the default voice.
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only needed with AUTENIA_VOICE_PROVIDER=elevenlabs.
# ElevenLabs → Profile → API Keys
ELEVENLABS_API_KEY=
# fal.ai — ONLY for avatar experiments. The faceless default never calls it.
# FAL_KEY=

# --- Telegram review and approval ---
# New bot from @BotFather.
TELEGRAM_BOT_TOKEN=
# Allowlist: the single chat authorised to approve. Anything else is dropped
# without a reply. Message the bot and read the chat id from getUpdates.
TELEGRAM_CHAT_ID=
# Only needed when Telegram runs by webhook; long polling does not use it.
# TELEGRAM_WEBHOOK_SECRET=

# --- Publishing ---
# Upload-Post API key. The three social accounts are connected in their
# dashboard, not here.
UPLOAD_POST_API_KEY=
# The Upload-Post profile whose TikTok, Instagram and YouTube are connected.
# Not a secret, but publishing without it fails at the vendor with a message
# that does not say what is wrong.
UPLOAD_POST_USER=

# A qué redes se sube, separadas por comas: tiktok, instagram, youtube.
# Sin la variable van las tres. Un nombre que no exista se descarta en vez de
# caer a "las tres": publicar en menos redes de la cuenta es un vídeo que subes
# a mano, publicar en más es un post en una cuenta que nadie quería tocar.
#
# El plan gratuito de Upload-Post cuenta las llamadas, así que una red que no
# esté conectada en su panel gasta una para contestar que no lo está.
# AUTENIA_REDES=youtube
# Cómo aterriza el vídeo en YouTube: public | unlisted | private. Cuesta la
# misma llamada, y "unlisted" deja verlo en la plataforma antes que el mundo.
# AUTENIA_YOUTUBE_PRIVACY=public

# --- Safety ---
# Publishing is simulated until this is explicitly false. Alone among the
# booleans, a malformed value here does NOT raise — it stays on. A typo must
# never be the thing that posts to the company's accounts.
AUTENIA_PUBLISH_DRY_RUN=true
# Single-user private deployment. Leave it on.
# AUTENIA_INTERNAL_MODE=true

# --- Vídeo generado (Veo) ---
# Apagado por defecto. Con "on", cada vídeo puede pagar hasta AUTENIA_MAX_NEW_CLIPS
# clips nuevos (~0,40 € cada uno) y reutiliza gratis todo lo que ya esté en caché.
# Los temas de Autenia se repiten, así que la biblioteca se llena y el coste baja.
AUTENIA_VIDEO_CLIPS=on
# Clips nuevos que puede pagar un vídeo. Todo lo que ya esté en la biblioteca se
# reutiliza gratis, y se empareja por significado: un clip de papeleo sirve para
# la escena de papeleo de mañana. Es el techo duro; el formato pide lo que
# necesita por debajo de él.
#
# 8 s es el máximo por generación: la API rechaza 10 y 12 ("between 4 and 8").
# "Más metraje" es por tanto más clips, no clips más largos.
AUTENIA_MAX_NEW_CLIPS=6

# --- Montaje ---
# Cómo se corta el vídeo, sin tocar lo que dice:
#   continuo  planos largos, subtítulo abajo
#   rapido    corte cada 2 s, subtítulo por grupos
#   kinetico  tipografía grande al centro, sin placa
#   titular   abre con el gancho escrito, cifras en color, barra de progreso
#   marcado   cifras en color, el dominio en pantalla, barra de progreso
# Se elige viendo muestras (python -m tools.muestras), no leyendo código. Un
# nombre que no exista cae al de por defecto en vez de tumbar el ciclo.
# AUTENIA_FORMATO=continuo

# --- Voice ---
# gemini (default, free, verified in Spanish) | elevenlabs
# AUTENIA_VOICE_PROVIDER=gemini
#
# Which voice. Con gemini, el defecto es Iapetus, elegido de oído el 30/07/2026
# entre Charon, Orus, Iapetus, Achird y Alnilam.
#
# Con elevenlabs solo hay cuatro, todas nativas de España y elegidas el
# 02/08/2026. Se pueden nombrar en vez de pegar el id:
#   Cadalso      redonda, agradable y creíble
#   Emilio       cálida, sólida y convincente
#   Ernesto      cercana, dinámica y natural
#   Marco Cruz   sólida, persuasiva e inteligente
#
# Es la voz de la marca en cada vídeo publicado: no se cambia sin escucharla.
# Compara con: python autenia_bot.py voces elevenlabs
# AUTENIA_VOICE_NAME=Cadalso

# --- Limits (hard stops, checked before spending) ---
# AUTENIA_MAX_COST_PER_VIDEO=0.50
# AUTENIA_MAX_COST_PER_MONTH=25.00
# AUTENIA_MAX_DURATION_S=55
# AUTENIA_TZ=Europe/Madrid

# --- Storage ---
# The database, the renders and Autenia's own footage. In Docker these point at
# the mounted volume; on a laptop the defaults below are relative to the repo.
# AUTENIA_DB_PATH=data/autenia.db
# AUTENIA_WORK_DIR=data/videos
# AUTENIA_LIBRARY_DIR=data/library

# --- Encoding ---
# x264 (default) | nvenc | auto. auto probes h264_nvenc once and falls back.
# FFMPEG_ENCODER=x264
# Loudness normalisation to -14 LUFS, the level TikTok/Reels/Shorts normalise
# playback to. Set to 0 only if you have a reason.
# AUDIO_NORMALIZE=1

# NEVER set BILLING_ENABLED. It belonged to the upstream's separately-licensed
# billing package, which is not in this repository, and the bot refuses to start
# with it on.

# --- YouTube ---
# Lo que se envía en la MISMA llamada de subida, así que no cuesta nada extra:
# la web del CTA y los hashtags van al final de la descripción, y los tres
# primeros hashtags son los únicos que se ven encima del título en un Short.
# AUTENIA_WEB=https://auteniaai.com/
# AUTENIA_YOUTUBE_HASHTAGS=#pymes #automatizacion #IA
# Categoría de YouTube. 28 es "Ciencia y tecnología"; la del proveedor por
# defecto es 22, "Gente y blogs", que es donde un vídeo sobre facturación se
# va a no encontrar.
# AUTENIA_YOUTUBE_CATEGORIA=28
