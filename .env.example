# ============================================================================
# Autenia Viral Shorts
# ============================================================================
# Every key is read here, server-side. There is no browser and no dashboard, so
# there is nowhere else a key could live. Copy this file to .env and fill in
# what the phase you are running needs — the bot boots without the rest and says
# what is missing when it reaches something that needs it.

# --- Provider keys ---
# Research, judgement, script and the default voice.
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only needed with AUTENIA_VOICE_PROVIDER=elevenlabs.
# ElevenLabs → Profile → API Keys
ELEVENLABS_API_KEY=
# fal.ai — ONLY for avatar experiments. The faceless default never calls it.
# FAL_KEY=

# --- Telegram review and approval ---
# New bot from @BotFather.
TELEGRAM_BOT_TOKEN=
# Allowlist: the single chat authorised to approve. Anything else is dropped
# without a reply. Message the bot and read the chat id from getUpdates.
TELEGRAM_CHAT_ID=
# Only needed when Telegram runs by webhook; long polling does not use it.
# TELEGRAM_WEBHOOK_SECRET=

# --- Publishing ---
# Upload-Post API key. The three social accounts are connected in their
# dashboard, not here.
UPLOAD_POST_API_KEY=
# The Upload-Post profile whose TikTok, Instagram and YouTube are connected.
# Not a secret, but publishing without it fails at the vendor with a message
# that does not say what is wrong.
UPLOAD_POST_USER=

# --- Safety ---
# Publishing is simulated until this is explicitly false. Alone among the
# booleans, a malformed value here does NOT raise — it stays on. A typo must
# never be the thing that posts to the company's accounts.
AUTENIA_PUBLISH_DRY_RUN=true
# Single-user private deployment. Leave it on.
# AUTENIA_INTERNAL_MODE=true

# --- Vídeo generado (Veo) ---
# Apagado por defecto. Con "on", cada vídeo puede pagar hasta AUTENIA_MAX_NEW_CLIPS
# clips nuevos (~0,40 € cada uno) y reutiliza gratis todo lo que ya esté en caché.
# Los temas de Autenia se repiten, así que la biblioteca se llena y el coste baja.
# AUTENIA_VIDEO_CLIPS=on
# AUTENIA_MAX_NEW_CLIPS=1

# --- Voice ---
# gemini (default, free, verified in Spanish) | elevenlabs
# AUTENIA_VOICE_PROVIDER=gemini
#
# Which voice. The default is Iapetus, a male Gemini voice Juan picked by ear on
# 2026-07-30 from Charon, Orus, Iapetus, Achird and Alnilam. It is the brand's
# voice on every published video — do not change it without listening first.
# AUTENIA_VOICE_NAME=Iapetus

# --- Limits (hard stops, checked before spending) ---
# AUTENIA_MAX_COST_PER_VIDEO=0.50
# AUTENIA_MAX_COST_PER_MONTH=25.00
# AUTENIA_MAX_DURATION_S=55
# AUTENIA_TZ=Europe/Madrid

# --- Storage ---
# The database, the renders and Autenia's own footage. In Docker these point at
# the mounted volume; on a laptop the defaults below are relative to the repo.
# AUTENIA_DB_PATH=data/autenia.db
# AUTENIA_WORK_DIR=data/videos
# AUTENIA_LIBRARY_DIR=data/library

# --- Encoding ---
# x264 (default) | nvenc | auto. auto probes h264_nvenc once and falls back.
# FFMPEG_ENCODER=x264
# Loudness normalisation to -14 LUFS, the level TikTok/Reels/Shorts normalise
# playback to. Set to 0 only if you have a reason.
# AUDIO_NORMALIZE=1

# NEVER set BILLING_ENABLED. It belonged to the upstream's separately-licensed
# billing package, which is not in this repository, and the bot refuses to start
# with it on.
