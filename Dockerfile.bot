# Autenia's review bot and daily cycle — the whole product, in one container.
#
# It used to build on the OpenShorts backend image, which carried torch, YOLO
# and Whisper for a pipeline this product does not run. Standalone and slim
# instead: python, ffmpeg, and four pure-python packages. That is the
# difference between an image a small VPS can pull and one it cannot.
#
# Long polling means no inbound ports, no domain and no certificate.
FROM python:3.11-slim

# ffmpeg composes the 9:16 master and ffprobe verifies it. Without them the bot
# starts fine and then fails the moment a script is approved, which is the worst
# possible time to discover a missing binary.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY core_config.py autenia_bot.py ./
COPY autenia/ ./autenia/
COPY fonts/ ./fonts/

# Nothing here needs root, and a bot that polls the internet should not have it.
RUN useradd --create-home --uid 10001 autenia \
    && mkdir -p /data && chown -R autenia:autenia /data /app
USER autenia

# The database, rendered videos and the footage library all live on a mounted
# volume, so restarting the container never loses a script awaiting review.
#
# The two caches belong here for a harder reason than convenience: their
# defaults are *relative* ("data/cache/clips"), so unpinned they resolve against
# WORKDIR into /app/data — the container's own writable layer, which is not the
# volume and does not survive a rebuild. Every `docker compose up --build` would
# then throw away footage that was paid for and buy it again, at about 0,40 € a
# clip and up to six a video. The cheapest line in this file.
ENV AUTENIA_DB_PATH=/data/autenia.db \
    AUTENIA_WORK_DIR=/data/videos \
    AUTENIA_LIBRARY_DIR=/data/library \
    AUTENIA_CLIP_CACHE=/data/cache/clips \
    AUTENIA_IMAGE_CACHE=/data/cache/images \
    PYTHONUNBUFFERED=1

# Says whether the configuration resolves and the binaries are there, without
# printing a single secret.
HEALTHCHECK --interval=5m --timeout=30s --start-period=30s \
    CMD python -c "import core_config, shutil, sys; core_config.settings.describe(); sys.exit(0 if shutil.which('ffmpeg') else 1)"

ENTRYPOINT ["python", "autenia_bot.py"]
CMD ["listen"]
